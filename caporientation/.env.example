# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=CapOrientation 360
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database, if direct connection is needed
DATABASE_URL=

# Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CapOrientation 360
BREVO_TEMPLATE_INVITATION_ID=
BREVO_TEMPLATE_REMINDER_ID=
BREVO_TEMPLATE_COMPLETED_COUNSELOR_ID=
BREVO_TEMPLATE_COMPLETED_BENEFICIARY_ID=

# Security
INVITATION_TOKEN_PEPPER=
SIGNED_URL_TTL_SECONDS=900
PUBLIC_RATE_LIMIT_PER_MINUTE=30

# Reports
REPORT_STORAGE_BUCKET=private-reports

# Optional observability
SENTRY_DSN=
LOG_LEVEL=info

# Development mail sandbox
MAIL_SANDBOX=true
MAIL_SANDBOX_RECIPIENT=
