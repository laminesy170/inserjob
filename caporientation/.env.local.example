# Development environment variables
# Copy this file to .env.local and fill in your values

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=CapOrientation 360
NODE_ENV=development

# Supabase - Get these from https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Brevo (skip for development with MAIL_SANDBOX)
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER_EMAIL=noreply@caporientation.fr
# BREVO_SENDER_NAME=CapOrientation 360

# Security
INVITATION_TOKEN_PEPPER=your-secret-pepper-string-here-minimum-32-chars
CRON_SECRET=your-cron-secret-token-for-email-processing

# Reports
REPORT_STORAGE_BUCKET=private-reports

# Optional observability
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
LOG_LEVEL=debug

# Development mail sandbox (sends all emails to a test recipient)
MAIL_SANDBOX=true
MAIL_SANDBOX_RECIPIENT=your-test-email@example.com

# Optional
SIGNED_URL_TTL_SECONDS=900
PUBLIC_RATE_LIMIT_PER_MINUTE=30
